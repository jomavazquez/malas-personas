# Database
DATABASE_URL="postgresql://user:password@localhost:5432/malas_personas"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Game timers (all optional — plain process.env reads with production-value fallbacks,
# not part of the strict env schema. Only meant to be overridden in .env.test so
# integration tests don't have to wait out the real 60s/20s/10s/2s durations.)
# VOM_VOTE_DURATION_MS=60000       # V_O_M: how long players have to vote before auto-resolve
# VOM_ROUND_BREATHER_MS=10000      # V_O_M: pause between reveal and the next round
# MP_ROUND_BREATHER_MS=2000        # Malas Personas: pause between winner reveal and the next round
# GAME_DISCONNECT_GRACE_MS=20000   # Both games: grace period before removing a dropped player
