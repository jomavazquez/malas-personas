# E2E environment for the Playwright suite (frontend/e2e/**).
# Points at a dedicated database on the same shared dev Postgres container — never
# the `malas_personas` dev database, and never `malas_personas_test` (backend integration
# tests use that one). Safe to commit: no real secrets, test-only.
DATABASE_URL="postgresql://malas:malas@localhost:5432/malas_personas_e2e"

# Server
PORT=3000
NODE_ENV=test

# JWT — e2e never verifies real user-facing tokens against a shared secret,
# but config/env.js still requires the field to be present and >=16 chars.
JWT_SECRET=e2e_jwt_secret_do_not_use_in_prod
JWT_EXPIRES_IN=7d

# CORS — must match wherever the Playwright-driven Vite preview server serves from.
CORS_ORIGIN=http://localhost:4173

# Game timers - shortened so e2e specs don't have to wait out the real
# 60s/20s/10s/2s production durations, but left generous enough (unlike the
# backend integration suite's much shorter values) that a multi-context browser
# spec has a comfortable window to read a transient reveal/result state across
# 2-3 real pages before the server auto-advances to the next round.
VOM_VOTE_DURATION_MS=5000
VOM_ROUND_BREATHER_MS=6000
MP_ROUND_BREATHER_MS=1500
GAME_DISCONNECT_GRACE_MS=1000
