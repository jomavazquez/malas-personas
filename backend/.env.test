# Test environment for the integration test suite (backend/tests/integration/**).
# Points at a dedicated database on the same shared dev Postgres container — never
# the `malas_personas` dev database. Safe to commit: no real secrets, test-only.
DATABASE_URL="postgresql://malas:malas@localhost:5432/malas_personas_test"

# Server
PORT=3001
NODE_ENV=test

# JWT — tests never verify real user-facing tokens against a shared secret,
# but config/env.js still requires the field to be present and >=16 chars.
JWT_SECRET=test_jwt_secret_do_not_use_in_prod
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Game timers - shortened so integration tests don't have to wait out the real
# 60s/20s/10s/2s production durations. See env.example for what each controls.
VOM_VOTE_DURATION_MS=500
VOM_ROUND_BREATHER_MS=200
MP_ROUND_BREATHER_MS=50
GAME_DISCONNECT_GRACE_MS=300
